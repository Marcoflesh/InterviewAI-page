FROM python:3.11.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY backend/requirements.txt /app/requirements.txt
RUN pip install -r /app/requirements.txt

COPY backend/app /app/app
# Scripts de diagnóstico y medición: docker compose exec backend python scripts/probar_ia.py
COPY scripts/probar_ia.py scripts/evaluar_evaluador.py /app/scripts/

# Ejecutar sin privilegios de root
RUN useradd --create-home --uid 10001 appuser && chown appuser /app
USER appuser

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
