# =============================================================================
# ARCHIVO DE CONFIGURACIÓN DE ENTORNOS Y LLAVES API (.env)
# Copia este archivo como `.env` en la raíz del proyecto:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. BASE DE DATOS POSTGRESQL
# -----------------------------------------------------------------------------
POSTGRES_USER=interviewai
POSTGRES_PASSWORD=interviewai_secret
POSTGRES_DB=interviewai
DATABASE_URL=postgresql://interviewai:interviewai_secret@db:5432/interviewai

# -----------------------------------------------------------------------------
# 2. AGENTES DE IA PRINCIPALES (GPT-4o mini y Gemini 3.8 Flash)
# >>> AQUÍ COLOCA TUS API KEYS PARA CARGAR LOS AGENTES DE GEMINI Y CHAT (OPENAI) <<<
# -----------------------------------------------------------------------------

# [PASO A] Coloca aquí tu API Key de OpenAI para el modelo de Chat (gpt-4o-mini):
OPENAI_API_KEY=PON_AQUI_TU_OPENAI_API_KEY
OPENAI_CHAT_MODEL=gpt-4o-mini

# [PASO B] Coloca aquí tu API Key de Google AI Studio para el modelo Gemini (gemini-3.8-flash):
GEMINI_API_KEY=PON_AQUI_TU_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash

# Proveedor activo para el Agente Evaluador ("gemini" | "openai" | "ollama"):
EVALUATOR_PROVIDER=gemini

# Proveedor activo para el Agente Entrevistador / Chat ("openai" | "gemini" | "ollama"):
INTERVIEWER_PROVIDER=openai

# -----------------------------------------------------------------------------
# 3. VERIFICADOR OFICIAL DE GOOGLE SIGN-IN (OAuth 2.0)
# >>> AQUÍ COLOCA TU CLIENT ID DE GOOGLE CLOUD CONSOLE <<<
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=PON_AQUI_TU_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# 4. RESPALDO LOCAL CON OLLAMA (Si no se usan llaves cloud)
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# -----------------------------------------------------------------------------
# 5. REGLAS DE SESIÓN EN LANGGRAPH
# -----------------------------------------------------------------------------
ENABLE_FOLLOWUP_QUESTIONS=false
FOLLOWUP_STAR_THRESHOLD=3
