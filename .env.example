# Base de datos PostgreSQL
POSTGRES_USER=interviewai
POSTGRES_PASSWORD=interviewai_secret
POSTGRES_DB=interviewai
DATABASE_URL=postgresql://interviewai:interviewai_secret@db:5432/interviewai

# Configuración de Ollama y Agentes LangGraph
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# Desactivar preguntas de seguimiento por defecto para priorizar preguntas aleatorias por carrera
ENABLE_FOLLOWUP_QUESTIONS=false
FOLLOWUP_STAR_THRESHOLD=3
DEFAULT_QUESTIONS_PER_SESSION=5

# Google OAuth 2.0 (Opcional en desarrollo local)
GOOGLE_CLIENT_ID=
