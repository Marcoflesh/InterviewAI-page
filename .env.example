# =============================================================================
# PLANTILLA DE CONFIGURACIÓN (.env)
#   cp .env.example .env      -> y llena tus valores en `.env`
# `.env` está en .gitignore y .dockerignore: NUNCA se sube a GitHub ni a la imagen.
# Guía paso a paso: PASO_A_PASO.md
# =============================================================================

# --- 1. Base de datos PostgreSQL ---------------------------------------------
POSTGRES_USER=interviewai
# Cambia esta contraseña (genera una con: python -c "import secrets;print(secrets.token_urlsafe(24))")
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA
POSTGRES_DB=interviewai
# Solo si corres el backend SIN Docker (con Docker se arma solo):
# DATABASE_URL=postgresql://interviewai:CAMBIA_ESTA_CONTRASENA@localhost:5432/interviewai

# --- 2. Agentes de IA ----------------------------------------------------------
# Agente Entrevistador: modelo LOCAL y gratuito con Ollama (ver sección 5).
# OpenAI es opcional (último respaldo). Déjalo vacío si no tienes saldo.
# La llave secreta empieza con "sk-" ("key_…" es solo el ID y no sirve).
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Google AI Studio (Agente Evaluador). La llave empieza con "AQ." (formato nuevo) o "AIza".
# Crea una en https://aistudio.google.com/apikey  (¡no es un token de GitHub "ghp_"!)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Proveedor principal de cada agente: gemini | openai | ollama
EVALUATOR_PROVIDER=gemini
INTERVIEWER_PROVIDER=ollama
# Cómo califica el evaluador: indicadores (rúbrica de 30 criterios, recomendado) | holistico (0-5 directo)
EVALUATOR_RUBRIC_MODE=indicadores

# --- 3. Google Sign-In ---------------------------------------------------------
# Client ID de tipo "Aplicación web" (termina en .apps.googleusercontent.com).
# Es público (no es secreto), pero debe ser EL MISMO en backend y frontend.
GOOGLE_CLIENT_ID=

# --- 4. Seguridad de sesiones --------------------------------------------------
# Firma de los tokens de sesión. Genera una con:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Orígenes que pueden llamar al backend (separados por coma)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://marcoflesh.github.io
# Verificación de registros MX al registrarse: strict | lenient | off
EMAIL_MX_CHECK=strict

# --- 5. Modelo local con Ollama (Agente Entrevistador, gratis) -----------------
# Se descarga solo la primera vez (servicio ollama-init). Opciones:
#   qwen3.5:4b  (~3.4 GB, laptops de 8 GB, recomendado)
#   qwen3.5:9b  (~6.6 GB, mejor calidad; 16 GB de RAM o GPU)
#   ministral-3:3b (~3 GB, buen español)
OLLAMA_ENABLED=true
OLLAMA_MODEL=qwen3.5:4b

# --- 6. Reglas de sesión en LangGraph ------------------------------------------
ENABLE_FOLLOWUP_QUESTIONS=false
FOLLOWUP_STAR_THRESHOLD=3
